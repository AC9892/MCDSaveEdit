<UserControl x:Class="MCDSaveEdit.UI.ItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Image x:Name="backImage"/>
        <Image x:Name="gildedImage" Margin="3,3,4,4"/>
        <Image x:Name="image" Source="../../Images/Artifacts.png" Margin="10"/>
        <Border x:Name="enchantmentGlintOverlay"
                Margin="7"
                CornerRadius="4"
                Opacity="0.55"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#007B5CFF" Offset="0"/>
                    <GradientStop Color="#007B5CFF" Offset="0.25"/>
                    <GradientStop Color="#A86F45E8" Offset="0.39"/>
                    <GradientStop Color="#B04DDCF5" Offset="0.47"/>
                    <GradientStop Color="#104DDCF5" Offset="0.58"/>
                    <GradientStop Color="#7070DFFF" Offset="0.72"/>
                    <GradientStop Color="#0070DFFF" Offset="0.84"/>
                    <GradientStop Color="#0070DFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Image x:Name="markedNewImage" Height="26" Width="26" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label x:Name="inventoryIndexLabel" Content="12345" FontSize="10" Margin="0" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="3,0"/>
        <Label x:Name="titleLabel" Content="*Boots of Swiftness*" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Center" FontSize="12" FontStretch="UltraCondensed"/>
        <Border x:Name="enchantmentPointsBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="2"
                Padding="3,1"
                CornerRadius="4"
                Background="#E3120C1D"
                BorderBrush="#CC9B6CFF"
                BorderThickness="1"
                ToolTip="Enchantment points invested">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="enchantmentPointsImage" Source="../../Images/Enchantments.png" Width="13" Height="13" Margin="0,0,3,0"/>
                <Label x:Name="enchantmentPointsLabel" Content="12345" FontSize="11" Padding="0" VerticalContentAlignment="Center" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>
        <Border x:Name="powerLabelBackground" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Padding="3,0" Background="#C9000000" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="3">
            <Label x:Name="powerLabel" Content="1234567890" Padding="0" FontSize="14" Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
