<UserControl x:Class="MCDSaveEdit.UI.EnchantmentSetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="130"
             MinWidth="0"
             d:DesignWidth="108">
    <UserControl.Resources>
        <Style x:Key="EnchantmentChoiceButton" TargetType="Button">
            <Setter Property="Background" Value="#E21B2028"/>
            <Setter Property="BorderBrush" Value="#B58F75AB"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path x:Name="diamond"
                                  Data="M 0,0 L 1,0 L 1,1 L 0,1 Z"
                                  Stretch="Fill"
                                  Margin="{TemplateBinding Padding}"
                                  Fill="{TemplateBinding Background}"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter Margin="3"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="diamond" Property="Fill" Value="#704A2578"/>
                                <Setter TargetName="diamond" Property="Stroke" Value="#C99B6CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="diamond" Property="Fill" Value="#9A6539A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="108" Height="130">
            <Image x:Name="backgroundImage"
                   Width="106" Height="106"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Stretch="Uniform"
                   Opacity="0.95"/>

            <Image x:Name="topEnchantmentSymbolImage"
                   Source="../../Images/Points.png"
                   Width="20" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,8,0,0"
                   Panel.ZIndex="3"/>

            <Canvas Width="108" Height="122" VerticalAlignment="Top">
                <Button x:Name="enchantment3Button"
                        Style="{StaticResource EnchantmentChoiceButton}"
                        Width="48" Height="48"
                        Canvas.Left="1" Canvas.Top="38">
                    <Image x:Name="enchantment3Image"
                           Source="../../Images/Enchantments.png"
                           Stretch="Uniform"/>
                </Button>

                <Button x:Name="enchantment2Button"
                        Style="{StaticResource EnchantmentChoiceButton}"
                        Width="48" Height="48"
                        Canvas.Left="59" Canvas.Top="38">
                    <Image x:Name="enchantment2Image"
                           Source="../../Images/Enchantments.png"
                           Stretch="Uniform"/>
                </Button>

                <Button x:Name="enchantment1Button"
                        Style="{StaticResource EnchantmentChoiceButton}"
                        Width="48" Height="48"
                        Canvas.Left="30" Canvas.Top="77"
                        Panel.ZIndex="2">
                    <Image x:Name="enchantment1Image"
                           Source="../../Images/Enchantments.png"
                           Stretch="Uniform"/>
                </Button>

                <Button x:Name="upgradedEnchantmentButton"
                        Style="{StaticResource EnchantmentChoiceButton}"
                        Width="70" Height="70"
                        Padding="10"
                        Canvas.Left="19" Canvas.Top="34"
                        Panel.ZIndex="4"
                        Visibility="Hidden">
                    <Image x:Name="upgradedEnchantmentImage"
                           Source="../../Images/Enchantments.png"
                           Stretch="Uniform"/>
                </Button>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
