<UserControl x:Class="MCDSaveEdit.UI.NetheriteEnchantmentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             mc:Ignorable="d" 
             d:DesignHeight="38" d:DesignWidth="300">
    <DockPanel LastChildFill="True">
        <Button x:Name="netheriteEnchantmentRemoveButton"
                DockPanel.Dock="Right"
                Style="{StaticResource IconButton}"
                Width="32" Height="32"
                Padding="0"
                Margin="5,0,0,0"
                FontSize="18" FontWeight="SemiBold"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="&#x00D7;"
                ToolTip="Remove gilded enchantment"
                Click="netheriteEnchantmentRemoveButton_Click"/>
        <Button x:Name="gildedButton" Padding="7,3" Margin="0,0,5,0" IsEnabled="false" Click="gildedButton_Click" DockPanel.Dock="Left" VerticalAlignment="Center">
            <CheckBox x:Name="gildedButtonCheckBox" IsEnabled="false">Gilded</CheckBox>
        </Button>
        <StackPanel x:Name="netheriteEnchantmentStack" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <Button x:Name="netheriteEnchantmentButton" Width="38" Height="38" Margin="0,0,5,0" Padding="3" Background="Transparent" Click="enchantmentImageButton_Click">
                <Image x:Name="netheriteEnchantmentImage" Width="30" Height="30" Margin="0" Stretch="Uniform"/>
            </Button>
            <TextBox x:Name="netheriteEnchantmentTextBox" TextChanged="tierTextBox_TextChanged" FontSize="15" HorizontalAlignment="Center" Width="38" Height="32" TextAlignment="Right" VerticalContentAlignment="Center"/>
            <local:Stepper x:Name="netheriteEnchantmentStepper" Width="20" Height="32" UpButtonClick="upButton_Click" DownButtonClick="downButton_Click"/>
            <Label x:Name="netheriteEnchantmentLabel" FontSize="13" Padding="0" VerticalAlignment="Center" Margin="7,0,2,0"/>
        </StackPanel>
    </DockPanel>
</UserControl>
