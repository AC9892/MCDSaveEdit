<UserControl x:Class="MCDSaveEdit.UI.ChestTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ElevatedCard}"
                HorizontalAlignment="Left"
                Padding="9,6"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="remainingEnchantmentPointsLabelImage"
                       Width="24" Height="24"
                       Source="../../Images/Enchantments.png"
                       Stretch="Uniform"/>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ENCHANT POINTS" Style="{StaticResource CaptionText}" FontSize="9"/>
                    <Label x:Name="remainingEnchantmentPointsLabel"
                           Content="1234567890"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    CornerRadius="6"
                    Padding="8">
                <local:ItemListScreen x:Name="itemListScreen"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"/>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    CornerRadius="6"
                    Padding="8">
                <local:ItemScreen x:Name="selectedItemScreen"/>
            </Border>

            <Rectangle x:Name="selectedEnchantmentScreenBackShadowRectangle"
                       Grid.ColumnSpan="3"
                       Visibility="Collapsed"
                       Fill="{DynamicResource AppOverlayBrush}"
                       Panel.ZIndex="10"/>

            <local:EnchantmentScreen x:Name="selectedEnchantmentScreen"
                                     Grid.ColumnSpan="3"
                                     Visibility="Collapsed"
                                     Margin="45"
                                     Panel.ZIndex="11"/>
        </Grid>
    </Grid>
</UserControl>
