<UserControl x:Class="MCDSaveEdit.UI.StatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="statsLabel" Text="Progress stat counters" Style="{StaticResource SectionTitleText}"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="statsStack"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="mobKillsLabel" Text="Mob kills" Style="{StaticResource SectionTitleText}"/>
                <Grid Grid.Row="1" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="mobSearchTextBox" ToolTip="Search mob names" TextChanged="mobSearchTextBox_TextChanged" Margin="0,0,8,0"/><ComboBox x:Name="mobSortComboBox" Grid.Column="1" SelectionChanged="mobSortComboBox_SelectionChanged"/></Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="mobKillsStack"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
