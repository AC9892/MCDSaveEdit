<Window x:Class="MCDSaveEdit.UI.TowerLiveMonitorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MCDSaveEdit.UI"
 Title="MCD Live Monitor" Width="620" Height="460" MinWidth="520" MinHeight="360" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Topmost="True" ShowInTaskbar="True" Opacity="0.94"
 Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen" Loaded="window_Loaded" Closed="window_Closed">
 <Window.Resources>
  <Style x:Key="OverlayCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}"/></Style>
  <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="2"/></Style>
  <Style x:Key="JsonPanel" TargetType="Border"><Setter Property="Background" Value="#101317"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition x:Name="titleRow" Height="50"/><RowDefinition Height="*"/><RowDefinition x:Name="footerRow" Height="25"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="titleBar_MouseLeftButtonDown"><Grid Margin="14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="36" Height="36" CornerRadius="18" Background="#2A1E38" BorderBrush="#A35CE8" BorderThickness="1"><TextBlock Text="△" Foreground="#C487FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center"><TextBlock Text="MCD LIVE MONITOR" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="fileNameText" Style="{StaticResource OverlayCaption}" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Overlay opacity"><TextBlock x:Name="opacityValueText" Text="94%" Style="{StaticResource OverlayCaption}" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="opacitySlider" Width="62" Minimum="35" Maximum="100" Value="94" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="opacitySlider_ValueChanged" VerticalAlignment="Center"/></StackPanel><Button x:Name="overlayModeButton" Content="EXPAND" Padding="9,4" MinHeight="28" Click="overlayModeButton_Click"/><Button x:Name="pinButton" Content="PINNED" Padding="9,4" MinHeight="28" Margin="6,0,0,0" Click="pinButton_Click"/><Button Content="—" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="minimizeButton_Click"/><Button Content="✕" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="closeButton_Click"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource ElevatedCard}" Padding="8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="statusDot" Width="8" Height="8" Fill="{DynamicResource AppWarningBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="7,0"><TextBlock x:Name="statusText" Text="Starting monitor…" FontWeight="SemiBold"/><TextBlock x:Name="writeInfoText" Text="Watching game process and complete character save" Style="{StaticResource OverlayCaption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Live Log" Click="viewLiveLogButton_Click" Margin="0,0,4,0" Padding="8,4" ToolTip="View what the monitor is detecting"/><StackPanel x:Name="expandedActionButtons" Orientation="Horizontal" Visibility="Collapsed"><Button Content="Refresh" Click="refreshButton_Click" Margin="0,0,4,0" Padding="8,4"/><Button Content="Folder" Click="openLogFolderButton_Click" Margin="0,0,4,0" Padding="8,4" ToolTip="Open the automatic export folder"/><Button Content="Copy" Style="{StaticResource PrimaryButton}" Click="copyButton_Click" Padding="8,4"/></StackPanel></StackPanel></Grid></Border>
   <TabControl x:Name="monitorTabs" Grid.Row="1" SelectionChanged="monitorTabs_SelectionChanged">
    <TabItem x:Name="overviewTab" Header="OVERVIEW"><ScrollViewer Margin="0,10,0,0"><StackPanel>
     <UniformGrid Columns="4"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CHARACTER" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="characterNameMetricText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GEAR POWER" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="gearPowerMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="EXPERIENCE" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="experienceMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SAVE SIZE" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="saveSizeMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
     <UniformGrid Columns="4"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="INVENTORY" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="inventoryCountMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#C487FF" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="STORAGE" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="storageCountMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="MERCHANTS" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="merchantCountMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="MOB TYPES" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="mobKillCountMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource ModernCard}" Margin="4,10"><StackPanel><TextBlock Text="CURRENCIES" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="currencyMetricText" Text="—" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="gameProcessTab" Header="GAME PROCESS"><ScrollViewer Margin="0,10,0,0"><StackPanel><UniformGrid Columns="4"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="STATE" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="processStateText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="processCpuText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="processMemoryText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="THREADS" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="processThreadsText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource ModernCard}" Margin="4,10"><StackPanel><TextBlock Text="PROCESS DETAILS" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="processDetailsText" Text="Waiting for Minecraft Dungeons…" TextWrapping="Wrap" Margin="0,8,0,0"/><Separator Margin="0,12"/><TextBlock Text="AUTO-EXPORTED SESSION LOG" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="sessionLogPathText" Text="—" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="towerSummaryTab" Header="TOWER"><ScrollViewer Margin="0,10,0,0"><StackPanel><UniformGrid Columns="4"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FLOOR" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="floorMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#C487FF" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LIVES LOST" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="livesMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="BOSSES" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="bossesMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SEED" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="seedMetricText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid><UniformGrid Columns="3"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="DIFFICULTY" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="difficultyMetricText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ARROWS" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="arrowsMetricText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ENCHANT POINTS" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="pointsMetricText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource ModernCard}" Margin="4,10"><StackPanel><TextBlock Text="TOWER LOADOUT" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="itemsMetricText" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/><Separator Margin="0,12"/><TextBlock x:Name="towerIdText" Text="—" Style="{StaticResource OverlayCaption}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="liveLogTab" Header="LIVE LOG"><Border Style="{StaticResource JsonPanel}" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="LIVE MONITOR EVENTS" Style="{StaticResource OverlayCaption}" VerticalAlignment="Center"/><Button Content="Clear" HorizontalAlignment="Right" Padding="8,3" Click="clearLiveLogButton_Click"/></Grid><TextBox x:Name="liveLogText" Grid.Row="1" Margin="0,7,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></Border></TabItem>
    <TabItem x:Name="characterJsonTab" Header="CHARACTER" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="characterJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="towerJsonTab" Header="TOWER JSON" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="towerJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="inventoryJsonTab" Header="INVENTORY" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="inventoryJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="storageJsonTab" Header="STORAGE" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="storageJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="merchantsJsonTab" Header="MERCHANTS" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="merchantsJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="progressJsonTab" Header="PROGRESS" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="progressJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
    <TabItem x:Name="rawJsonTab" Header="RAW SAVE" Visibility="Collapsed"><Border Style="{StaticResource JsonPanel}"><local:JsonSyntaxRichTextBox x:Name="rawJsonText" Background="Transparent" BorderThickness="0"/></Border></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,3,16,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LOG EXPORT" Style="{StaticResource OverlayCaption}"/><TextBlock x:Name="exportFolderPathText" Grid.Column="1" Style="{StaticResource OverlayCaption}" Margin="7,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="changeCountText" Grid.Column="2" Text="0 updates" Style="{StaticResource OverlayCaption}"/></Grid></Border>
 </Grid></Border>
</Window>
