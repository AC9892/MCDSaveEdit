<Window x:Class="MCDSaveEdit.UI.ValidationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Save Validation" Height="540" Width="820" MinHeight="400" MinWidth="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Save validation" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="summaryTextBlock" Style="{StaticResource BodyText}" Margin="0,5,0,16" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="6"><ListView x:Name="issuesListView"><ListView.View><GridView><GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="90"/><GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="240"/><GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="420"/></GridView></ListView.View></ListView></Border><Grid Grid.Row="2" Margin="0,14,0,0"><Button Content="Copy Report" HorizontalAlignment="Left" Click="copyReportButton_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="closeButton" Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/><Button x:Name="saveAnywayButton" Content="Save Anyway" Width="130" Style="{StaticResource PrimaryButton}" Click="saveAnywayButton_Click"/></StackPanel></Grid></Grid>
</Window>
