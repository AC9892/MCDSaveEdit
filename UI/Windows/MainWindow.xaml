<Window x:Class="MCDSaveEdit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCDSaveEdit.UI"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
        MinHeight="650" MinWidth="1000" Title="MCDSaveEdit Community"
        Closing="mainWindow_Closing" Closed="mainWindow_Closed" WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="exitCommandBinding_Executed"/><CommandBinding Command="Open" Executed="openCommandBinding_Executed"/><CommandBinding Command="Save" Executed="saveCommandBinding_Executed"/><CommandBinding Command="SaveAs" Executed="saveAsCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="Open"/><KeyBinding Key="S" Modifiers="Control" Command="Save"/><KeyBinding Key="S" Modifiers="Control+Shift" Command="SaveAs"/><KeyBinding Key="Q" Modifiers="Control" Command="Close"/>
    </Window.InputBindings>

    <Grid AllowDrop="True" Drop="window_File_Drop">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <!-- Modern application header -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MCDSaveEdit" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="COMMUNITY EDITION" Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="characterNameTextBlock" Text="No character loaded" FontSize="15" FontWeight="SemiBold"/>
                        <Border x:Name="unsavedBadge" Style="{StaticResource StatusBadge}" Margin="10,0,0,0" Visibility="Collapsed"><TextBlock Text="Unsaved" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="fileNameTextBlock" Text="Open a character save to begin" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="  •  " Style="{StaticResource CaptionText}"/>
                        <TextBlock x:Name="powerTextBlock" Text="Power —" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Command="Open" Margin="0,0,8,0" ToolTip="Open save (Ctrl+O)"/>
                    <Button x:Name="quickSaveButton" Content="Save" Command="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" ToolTip="Save (Ctrl+S)"/>
                    <Button x:Name="moreButton" Content="•••" Style="{StaticResource IconButton}" Click="moreButton_Click" ToolTip="More commands">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Save As..." Click="saveAsMenuItem_Click"/>
                                <MenuItem x:Name="restoreBackupMenuItem" Header="Restore Backup..." Click="restoreBackupMenuItem_Click"/>
                                <MenuItem x:Name="recentFilesMenuItem" Header="Recent Files"/>
                                <Separator/>
                                <MenuItem Header="Game Content">
                                    <MenuItem x:Name="gameFilesVersionMenuItem" Header="Unknown Game Version" IsEnabled="False"/>
                                    <MenuItem x:Name="gameFilesLocationMenuItem" Header="No Game Files" IsEnabled="False"/>
                                    <Separator/><MenuItem x:Name="relaunchToChangeMenuItem" Header="Locate or reload game files..." Click="relaunchMenuItem_Click"/>
                                </MenuItem>
                                <MenuItem x:Name="langMenuItem" Header="Language"><MenuItem x:Name="noneLangMenuItem" Header="None" IsChecked="True"/></MenuItem>
                                <Separator/>
                                <MenuItem Header="Validate Current Save" Click="validateCurrentSaveMenuItem_Click"/>
                                <MenuItem Header="Open Logs Folder" Click="openLogsFolderMenuItem_Click"/>
                                <MenuItem Header="Copy Diagnostics" Click="copyDiagnosticInformationMenuItem_Click"/>
                                <Separator/>
                                <MenuItem x:Name="aboutMenuItem" Header="About" Click="aboutMenuItem_Click"/>
                                <MenuItem x:Name="updateMenuItem" Header="Get New Version" Visibility="Collapsed" Click="updateMenuItem_Click"/>
                                <MenuItem Header="Exit" Click="exitMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Menu Visibility="Collapsed"><MenuItem x:Name="fileMenuItem"><MenuItem x:Name="openMenuItem" Command="Open"/><MenuItem x:Name="saveMenuItem" Command="Save"/><MenuItem x:Name="saveAsMenuItem" Command="SaveAs"/><MenuItem x:Name="exitMenuItem" Command="Close"/></MenuItem><MenuItem x:Name="settingsMenuItem" Click="settingsMenuItem_Click"/></Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="4,8"/>
                        <RadioButton x:Name="settingsNavigationButton" Content="Settings" Tag="⚙" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EDITOR" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="12,0,0,8"/>
                        <RadioButton x:Name="homeNavigationButton" Content="Home" Tag="⌂" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" IsChecked="True" Checked="navigationButton_Click" CommandParameter="0"/>
                        <RadioButton Content="Character" Tag="♟" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="1"/>
                        <RadioButton x:Name="inventoryNavigationButton" Content="Inventory" Tag="▦" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="2"/>
                        <RadioButton Content="Storage" Tag="▤" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="3"/>
                        <RadioButton Content="Tower" Tag="△" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="4"/>
                        <RadioButton Content="Advanced" Tag="◇" GroupName="Navigation" Style="{StaticResource SideNavigationItem}" Checked="navigationButton_Click" CommandParameter="5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Padding="16">
                <TabControl x:Name="mainTabControl" SelectedIndex="0">
                    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
                    <TabItem Header="Home">
                        <Grid>
                            <StackPanel x:Name="emptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AppSelectionBrush}" HorizontalAlignment="Center"><TextBlock Text="◇" FontSize="30" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="No save loaded" Style="{StaticResource PageTitleText}" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                                <TextBlock Text="Open a Minecraft Dungeons character save to view and edit its inventory, storage, currencies, progression, and equipment." Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"/>
                                <Button Content="Open Save" Command="Open" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="120"/>
                            </StackPanel>
                            <StackPanel x:Name="loadedHomePanel" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                <TextBlock Text="Character overview" Style="{StaticResource PageTitleText}"/>
                                <TextBlock Text="Your active save and game-content status at a glance." Style="{StaticResource BodyText}" Margin="0,4,0,18"/>
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource ModernCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CHARACTER" Style="{StaticResource CaptionText}"/><TextBlock x:Name="homeCharacterText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource ModernCard}" Margin="5,0"><StackPanel><TextBlock Text="POWER" Style="{StaticResource CaptionText}"/><TextBlock x:Name="homePowerText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource ModernCard}" Margin="10,0,0,0"><StackPanel><TextBlock Text="GAME CONTENT" Style="{StaticResource CaptionText}"/><TextBlock x:Name="homeGameContentText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                </UniformGrid>
                                <Border Style="{StaticResource ModernCard}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="FILE" Style="{StaticResource CaptionText}"/><TextBlock x:Name="homeFileText" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="MODIFIED" Style="{StaticResource CaptionText}"/><TextBlock x:Name="homeModifiedText" Grid.Column="3" Text="—"/><TextBlock Grid.Row="1" Text="BACKUP" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/><TextBlock x:Name="homeBackupText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,10,0,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="VALIDATION" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/><TextBlock x:Name="homeValidationText" Grid.Row="1" Grid.Column="3" Text="Ready" Margin="0,10,0,0"/></Grid></Border>
                                <WrapPanel Margin="0,14,0,0"><Button Content="Save" Command="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Save As..." Command="SaveAs" Margin="0,0,8,8"/><Button Content="Restore Backup" Click="restoreBackupMenuItem_Click" Margin="0,0,8,8"/><Button Content="Validate Save" Click="validateCurrentSaveMenuItem_Click" Margin="0,0,8,8"/></WrapPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="statsTabItem" Header="Character" Selector.Selected="OnTabSelected"><TabControl><TabItem Header="STATS"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Character" Style="{StaticResource PageTitleText}"/><TextBlock Text="Progression and combat statistics." Style="{StaticResource BodyText}" Margin="0,3,0,10"/></StackPanel><UniformGrid Grid.Row="1" Columns="3"><Border Style="{StaticResource ModernCard}" Padding="12" Margin="0,0,5,10"><StackPanel><TextBlock Text="LEVEL" Style="{StaticResource CaptionText}"/><TextBlock x:Name="characterLevelTextBlock" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource ModernCard}" Padding="12" Margin="5,0,5,10"><StackPanel><TextBlock Text="POWER" Style="{StaticResource CaptionText}"/><TextBlock x:Name="characterPowerOverviewTextBlock" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource ModernCard}" Padding="12" Margin="5,0,0,10"><StackPanel><TextBlock Text="STRONGHOLD PORTAL" Style="{StaticResource CaptionText}"/><CheckBox x:Name="characterPortalCheckBox" Content="Unlocked" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0" Click="characterPortalCheckBox_Click"/></StackPanel></Border></UniformGrid><local:StatsTab x:Name="statsTab" Grid.Row="2"/></Grid></TabItem><TabItem x:Name="campMerchantsTabItem" Header="CAMP MERCHANTS" Selector.Selected="campMerchantsTabItem_Selected"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Camp merchants" Style="{StaticResource PageTitleText}"/><TextBlock Text="Edit interaction, restock, pricing, reservation, and stocked-item data." Style="{StaticResource BodyText}" Margin="0,3,0,12"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ModernCard}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="MERCHANTS" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/><ListBox x:Name="campMerchantList" SelectionChanged="campMerchantList_SelectionChanged"/></DockPanel></Border><Border Grid.Column="2" Style="{StaticResource ModernCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="campMerchantTitleText" Text="Select a merchant" Style="{StaticResource SectionTitleText}"/><CheckBox x:Name="campMerchantInteractedCheckBox" Content="Merchant unlocked / interacted" Style="{StaticResource ToggleSwitch}" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TIMES RESTOCKED" Style="{StaticResource CaptionText}"/><TextBox x:Name="campMerchantRestocksTextBox" Margin="0,5,0,0"/></StackPanel></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10"><StackPanel x:Name="campMerchantSlotsPanel"/></ScrollViewer><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changes use the normal character Save command and backup system." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><Button x:Name="applyCampMerchantButton" Grid.Column="1" Content="Apply Merchant Changes" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="applyCampMerchantButton_Click"/></Grid></Grid></Border></Grid></Grid></TabItem></TabControl></TabItem>
                    <TabItem x:Name="inventoryTabItem" Header="Inventory" Selector.Selected="OnTabSelected"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Inventory" Style="{StaticResource PageTitleText}"/><TextBlock Text="Equipment, currencies, item filters, and selected-item editing." Style="{StaticResource BodyText}" Margin="0,4,0,14"/></StackPanel><Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10"><local:InventoryTab x:Name="inventoryTab"/></Border></Grid></TabItem>
                    <TabItem x:Name="chestTabItem" Header="Storage" Selector.Selected="OnTabSelected"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Storage" Style="{StaticResource PageTitleText}"/><TextBlock Text="Manage items stored in the character's storage chest." Style="{StaticResource BodyText}" Margin="0,4,0,14"/></StackPanel><Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10"><local:ChestTab x:Name="chestTab"/></Border></Grid></TabItem>
                    <TabItem Header="Tower"><TabControl><TabItem Header="RUN PROGRESS"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Tower editor" Style="{StaticResource PageTitleText}"/><TextBlock Text="Modify synchronized fields in the active Tower run." Style="{StaticResource BodyText}" Margin="0,3,0,12"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="58*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="42*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ModernCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Run progress" Style="{StaticResource SectionTitleText}"/><TextBlock x:Name="towerEditorStatusText" Text="Load the Tower data from the current character." Style="{StaticResource BodyText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Reload Tower Data" Click="reloadTowerEditorButton_Click" Margin="10,0,0,0"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10"><Grid x:Name="towerEditorPanel" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="FLOOR INDEX" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerFloorTextBox" Margin="0,5,0,0"/><TextBlock x:Name="towerFloorRangeText" Text="Valid range will appear after loading." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LIVES LOST" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerLivesTextBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock Text="BOSSES KILLED" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerBossesTextBox" Margin="0,5,0,0"/><TextBlock Text="Valid range: 0–3" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0"><TextBlock Text="ARROWS" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerArrowsTextBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="TOWER ENCHANT POINTS" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerPointsTextBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0"><TextBlock Text="FLOOR STATE" Style="{StaticResource CaptionText}"/><CheckBox x:Name="towerFloorCompletedCheckBox" Content="Current floor completed" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"/></StackPanel></Grid></ScrollViewer><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="The game must be closed. A timestamped backup is always created." Style="{StaticResource CaptionText}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="saveTowerChangesButton" Grid.Column="1" Content="Save Tower Changes" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="saveTowerChangesButton_Click" Margin="12,0,0,0"/></Grid></Grid></Border><Border Grid.Column="2" Style="{StaticResource ModernCard}"><StackPanel><TextBlock Text="Active run" Style="{StaticResource SectionTitleText}"/><Border Style="{StaticResource ElevatedCard}" Margin="0,12,0,0"><StackPanel><TextBlock Text="TOWER ID" Style="{StaticResource CaptionText}"/><TextBlock x:Name="towerEditorIdText" Text="—" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><UniformGrid Columns="2" Margin="0,10,0,0"><Border Style="{StaticResource ElevatedCard}" Margin="0,0,5,0"><StackPanel><TextBlock Text="DIFFICULTY" Style="{StaticResource CaptionText}"/><TextBlock x:Name="towerEditorDifficultyText" Text="—" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource ElevatedCard}" Margin="5,0,0,0"><StackPanel><TextBlock Text="SEED" Style="{StaticResource CaptionText}"/><TextBlock x:Name="towerEditorSeedText" Text="—" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid><TextBlock Text="TOWER LOADOUT" Style="{StaticResource CaptionText}" Margin="0,16,0,5"/><TextBlock x:Name="towerEditorItemsText" Text="—" TextWrapping="Wrap"/><Separator Margin="0,16"/><TextBlock Text="The generated route, enemies, rewards, Tower ID, and item structures remain read-only to avoid producing an invalid run." Style="{StaticResource BodyText}" TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid></TabItem><TabItem Header="MERCHANT"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tower merchant" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="towerMerchantStatusText" Text="Load Tower data to inspect merchant state and offers." Style="{StaticResource BodyText}" Margin="0,3,0,12"/></StackPanel><Button Grid.Column="1" Content="Reload Merchant Data" Click="reloadTowerMerchantButton_Click" Margin="10,0,0,12"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="38*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="62*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ModernCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="DETECTED ITEMS" Style="{StaticResource CaptionText}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><WrapPanel x:Name="towerMerchantItemsPanel"/></ScrollViewer></Grid></Border><Border Grid.Column="2" Style="{StaticResource ModernCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PLAYER MERCHANT INTERACTIONS (JSON ARRAY)" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerMerchantInteractionsTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,6,0,0"/></Grid><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="OFFERED FLOOR REWARDS (JSON OBJECT)" Style="{StaticResource CaptionText}"/><TextBox x:Name="towerMerchantRewardsTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,6,0,0"/></Grid><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Game must be closed; JSON shape is validated and backed up." Style="{StaticResource CaptionText}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Reset Fields" Click="resetTowerMerchantButton_Click" Margin="8,0"/><Button x:Name="saveTowerMerchantButton" Grid.Column="2" Content="Save Merchant Changes" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="saveTowerMerchantButton_Click"/></Grid></Grid></Border></Grid></Grid></TabItem></TabControl></TabItem>
                    <TabItem Header="Advanced"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Advanced" Style="{StaticResource PageTitleText}"/><TextBlock Text="Live observation, validation, diagnostics, and safety-gated fields." Style="{StaticResource BodyText}" Margin="0,3,0,12"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="42*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="58*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ModernCard}"><StackPanel><TextBlock Text="MCD Live Monitor" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Watch the game process and complete character save in real time, with separate Tower, inventory, storage, merchant, progress, and raw-data views plus automatic session-log export." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button x:Name="openTowerLiveMonitorButton" Content="Open Live Monitor" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="openTowerLiveMonitorButton_Click"/><Border Style="{StaticResource ElevatedCard}" Margin="0,16,0,0"><StackPanel><TextBlock Text="READ ONLY" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AppSuccessBrush}"/><TextBlock Text="The monitor never writes to the character save. It exports timestamped process samples and save snapshots to its own local log folder." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource ModernCard}"><StackPanel><TextBlock Text="Advanced editing is safety-gated" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource AppWarningBrush}"/><TextBlock Text="Raw item type, power, index, UUID, and related internal fields remain collapsed inside the selected-item inspector unless Advanced Editing is enabled in Settings." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,18"/><WrapPanel><Button Content="Validate Current Save" Click="validateCurrentSaveMenuItem_Click" Margin="0,0,8,8"/><Button Content="Copy Diagnostics" Click="copyDiagnosticInformationMenuItem_Click" Margin="0,0,8,8"/><Button Content="Open Logs" Click="openLogsFolderMenuItem_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border></Grid></Grid></TabItem>
                    <TabItem Header="Settings"><ContentControl x:Name="settingsHost"/></TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid><TextBlock x:Name="statusTextBlock" Text="Ready" Style="{StaticResource CaptionText}"/><TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionText}"><Run Text="Game assets: "/><Run x:Name="gameAssetStatusRun" Text="checking"/></TextBlock></Grid>
        </Border>
        <Border x:Name="toastBorder" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Style="{StaticResource ElevatedCard}" Padding="14,9" Visibility="Collapsed" Panel.ZIndex="20"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="{DynamicResource AppSuccessBrush}" FontWeight="SemiBold"/><TextBlock x:Name="toastTextBlock" Margin="8,0,0,0"/></StackPanel></Border>
    </Grid>
</Window>
