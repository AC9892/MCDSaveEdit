<Window x:Class="MCDSaveEdit.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings — MCDSaveEdit" Height="650" Width="900" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="settingsWindow_Closing">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.RowSpan="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="12,20"><StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitleText}" Margin="10,0,0,18"/><RadioButton Content="General" Tag="⌂" IsChecked="True" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="0"/><RadioButton Content="Appearance" Tag="◐" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="1"/><RadioButton Content="Game Files" Tag="▣" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="2"/><RadioButton Content="Backups" Tag="↶" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="3"/><RadioButton Content="Advanced" Tag="◇" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="4"/><RadioButton Content="About" Tag="ⓘ" GroupName="Settings" Style="{StaticResource SideNavigationItem}" Checked="settingNavigation_Click" CommandParameter="5"/></StackPanel></Border>
  <Border Grid.Column="1" Padding="26,22,26,12"><TabControl x:Name="settingsTabControl"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
   <TabItem><StackPanel><TextBlock Text="General" Style="{StaticResource PageTitleText}"/><TextBlock Text="Everyday editor behavior." Style="{StaticResource BodyText}" Margin="0,4,0,18"/><Border Style="{StaticResource ModernCard}"><CheckBox x:Name="confirmOverwriteCheckBox" Content="Confirm before overwriting an existing save"/></Border></StackPanel></TabItem>
   <TabItem><StackPanel><TextBlock Text="Appearance" Style="{StaticResource PageTitleText}"/><TextBlock Text="Theme changes preview immediately and follow Windows in System mode." Style="{StaticResource BodyText}" Margin="0,4,0,18"/><Border Style="{StaticResource ModernCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Theme" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Choose Light, Dark, or System." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="themeComboBox" Grid.Column="1" SelectionChanged="themeComboBox_SelectionChanged"/></Grid></Border></StackPanel></TabItem>
   <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Game Files" Style="{StaticResource PageTitleText}"/><TextBlock Text="Find Minecraft Dungeons data for item names and images." Style="{StaticResource BodyText}" Margin="0,4,0,18"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource ModernCard}"><StackPanel><TextBlock Text="PAK DIRECTORY" Style="{StaticResource CaptionText}"/><TextBox x:Name="gamePakPathTextBox" Margin="0,8,0,0" TextChanged="gamePakPathTextBox_TextChanged"/><WrapPanel Margin="0,10,0,0"><Button Content="Auto Detect" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="autoDetectGameFilesButton_Click"/><Button Content="Browse" Margin="0,0,8,8" Click="browseGameFilesButton_Click"/><Button Content="Rescan" Margin="0,0,8,8" Click="rescanGameFilesButton_Click"/><Button Content="Reset" Margin="0,0,8,8" Click="resetGameFilesButton_Click"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource ModernCard}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Installation" Style="{StaticResource CaptionText}"/><TextBlock x:Name="gameInstallationTypeTextBlock" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Game root" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/><TextBlock x:Name="gameRootTextBlock" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Text="Status" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/><TextBlock x:Name="gameFileStatusTextBlock" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,8,0,0"/></Grid></Border><WrapPanel Margin="0,12,0,0"><Button x:Name="openGameFolderButton" Content="Open Folder" Margin="0,0,8,8" Click="openGameFolderButton_Click"/><Button Content="Clear Image Cache" Margin="0,0,8,8" Click="clearImageCacheButton_Click"/></WrapPanel></StackPanel></ScrollViewer></Grid></TabItem>
   <TabItem><StackPanel><TextBlock Text="Backups" Style="{StaticResource PageTitleText}"/><TextBlock Text="Safe copies are created before existing saves are replaced." Style="{StaticResource BodyText}" Margin="0,4,0,18"/><Border Style="{StaticResource ModernCard}"><StackPanel><CheckBox x:Name="automaticBackupsCheckBox" Content="Automatically create backups"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Backups to keep" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Per character save, from 1 to 1000." Style="{StaticResource CaptionText}"/></StackPanel><TextBox x:Name="backupRetentionTextBox" Grid.Column="1" TextAlignment="Right"/></Grid><Button x:Name="openBackupFolderButton" Content="Open Backup Folder" HorizontalAlignment="Left" Margin="0,16,0,0" Click="openBackupFolderButton_Click"/></StackPanel></Border></StackPanel></TabItem>
   <TabItem><StackPanel><TextBlock Text="Advanced" Style="{StaticResource PageTitleText}"/><TextBlock Text="Safety, validation, live overlay, and local diagnostics." Style="{StaticResource BodyText}" Margin="0,4,0,18"/><Border Style="{StaticResource ModernCard}"><StackPanel><CheckBox x:Name="saveValidationCheckBox" Content="Validate saves before writing"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Validation strictness" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Strict mode uses loaded game IDs when available." Style="{StaticResource CaptionText}"/></StackPanel><ComboBox x:Name="validationStrictnessComboBox" Grid.Column="1"/></Grid><Separator Margin="0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Live monitor hotkey" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Shows or hides the compact overlay, even while the game is focused." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="liveMonitorHotkeyTextBox" Grid.Column="1" PreviewKeyDown="liveMonitorHotkeyTextBox_PreviewKeyDown" ToolTip="Click here, then press a key combination" HorizontalContentAlignment="Center"/></Grid><Separator Margin="0,16"/><CheckBox x:Name="advancedEditingCheckBox" Content="Enable advanced editing and raw internal values"/><CheckBox x:Name="diagnosticsLoggingCheckBox" Margin="0,12,0,0" Content="Write private diagnostic logs locally"/><CheckBox x:Name="startupDiagnosticsCheckBox" Margin="0,12,0,0" Content="Show technical startup details automatically"/></StackPanel></Border></StackPanel></TabItem>
   <TabItem><StackPanel><TextBlock Text="About" Style="{StaticResource PageTitleText}"/><Border Style="{StaticResource ModernCard}" Margin="0,18,0,0"><StackPanel><TextBlock Text="MCDSaveEdit Community" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Version 1.6.0" Foreground="{DynamicResource AppAccentBrush}" Margin="0,4,0,12"/><TextBlock Text="An unofficial maintained fork of the Minecraft Dungeons Save File Editor created by Michael Holt (CutFlame). Telemetry is disabled. Save contents and encryption keys are never included in diagnostic reports." Style="{StaticResource BodyText}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></TabItem>
  </TabControl></Border>
  <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="22,12"><Grid><TextBlock x:Name="validationMessage" Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Reset" Width="90" Margin="0,0,8,0" Click="cancelButton_Click"/><Button Content="Apply Changes" Width="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="saveButton_Click"/></StackPanel></Grid></Border>
 </Grid>
</Window>
