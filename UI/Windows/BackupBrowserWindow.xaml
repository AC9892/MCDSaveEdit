<Window x:Class="MCDSaveEdit.UI.BackupBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Restore Backup" Height="560" Width="980" MinHeight="420" MinWidth="760" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Restore a backup" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="summaryTextBlock" Style="{StaticResource BodyText}" Margin="0,5,0,16" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="6"><ListView x:Name="backupsListView" SelectionChanged="backupsListView_SelectionChanged" MouseDoubleClick="backupsListView_MouseDoubleClick"><ListView.View><GridView><GridViewColumn Header="Save" DisplayMemberBinding="{Binding SaveFileName}" Width="120"/><GridViewColumn Header="Backup" DisplayMemberBinding="{Binding BackupFileName}" Width="220"/><GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="100"/><GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="110"/><GridViewColumn Header="Size" DisplayMemberBinding="{Binding FileSize}" Width="100"/><GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="280"/></GridView></ListView.View></ListView></Border><Grid Grid.Row="2" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="Refresh" Margin="0,0,8,0" Click="refreshButton_Click"/><Button x:Name="openFolderButton" Content="Open Folder" Click="openFolderButton_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/><Button x:Name="restoreButton" Content="Restore Selected" Width="135" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="restoreButton_Click"/></StackPanel></Grid></Grid>
</Window>
