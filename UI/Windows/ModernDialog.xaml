<Window x:Class="MCDSaveEdit.UI.ModernDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" SizeToContent="Height" MaxHeight="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AppSelectionBrush}"><TextBlock x:Name="iconTextBlock" Text="!" FontSize="19" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="titleTextBlock" Grid.Column="1" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
  <TextBlock x:Name="messageTextBlock" Grid.Row="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="44,14,0,0"/>
  <Expander x:Name="detailsExpander" Grid.Row="2" Header="Show Details" Margin="44,14,0,0" Visibility="Collapsed"><Border Style="{StaticResource ElevatedCard}" Padding="8" Margin="0,8,0,0"><TextBox x:Name="detailsTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="10" MaxHeight="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></Border></Expander>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="tertiaryButton" MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed" Click="tertiaryButton_Click"/><Button x:Name="secondaryButton" MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed" Click="secondaryButton_Click"/><Button x:Name="primaryButton" MinWidth="96" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="primaryButton_Click"/></StackPanel>
 </Grid>
</Window>
