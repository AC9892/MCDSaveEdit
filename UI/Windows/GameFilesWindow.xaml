<Window x:Class="MCDSaveEdit.UI.GameFilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minecraft Dungeons game files" ResizeMode="NoResize" Height="520" Width="700" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AppSelectionBrush}"><TextBlock Text="!" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AppWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Minecraft Dungeons files weren't found" Style="{StaticResource PageTitleText}" FontSize="21"/><TextBlock x:Name="messageTextBlock" Text="MCDSaveEdit can still open saves, but item images and some game-data features may be unavailable." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
  <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,22,0,0"><StackPanel><TextBlock x:Name="gameFilesGroupBox" Text="Locate game files" Style="{StaticResource SectionTitleText}"/><TextBlock x:Name="pathLabel" Text="Choose the Minecraft Dungeons folder or its Content\Paks directory." Style="{StaticResource CaptionText}" Margin="0,4,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="pathTextBox"/><Button x:Name="pathBrowseButton" Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="pathBrowseButton_Click"/></Grid><TextBlock x:Name="statusTextBlock" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
  <Expander Grid.Row="2" Header="Show search locations" Margin="0,14,0,0"><Border Style="{StaticResource ElevatedCard}" Padding="8" Margin="0,8,0,0"><TextBox x:Name="searchLocationsTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="10" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></Border></Expander>
  <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="exitButton" Content="Exit" Style="{StaticResource DangerButton}" Click="exitButton_Click"/><Button x:Name="autoDetectButton" Grid.Column="2" Content="Retry Detection" Margin="0,0,8,0" Click="autoDetectButton_Click"/><Button x:Name="noButton" Grid.Column="3" Content="Continue Without Game Files" Margin="0,0,8,0" Click="noButton_Click"/><Button x:Name="okButton" Grid.Column="4" Content="Use This Folder" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="okButton_Click"/></Grid>
 </Grid>
</Window>
