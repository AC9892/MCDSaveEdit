<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="SideNavigationTemplate" TargetType="{x:Type RadioButton}"><Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Indicator" Grid.Column="0" Width="3" Background="Transparent" CornerRadius="2"/><TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/><ContentPresenter Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource AppElevatedBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSelectionBrush}"/><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AppAccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
    <Style x:Key="SideNavigationItem" TargetType="RadioButton"><Setter Property="Template" Value="{StaticResource SideNavigationTemplate}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
</ResourceDictionary>
