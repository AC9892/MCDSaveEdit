<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ModernCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource ModernCard}"><Setter Property="Background" Value="{DynamicResource AppElevatedBrush}"/></Style>
    <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/></Style>
</ResourceDictionary>
